modules = ["nodejs-24", "php-8.4", "postgresql-16", "python-base-3.13"]

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "SI-KB SMART (Laravel)"

[[workflows.workflow]]
name = "SI-KB SMART (Laravel)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd sikb-smart && php artisan serve --host=0.0.0.0 --port=5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
